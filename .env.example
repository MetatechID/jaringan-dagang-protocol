# Local Compose only. Use URL-safe alphanumeric passwords (embedded in DB URLs).
POSTGRES_PASSWORD=replace-with-random-local-password
BAP_ADMIN_TOKEN=replace-with-random-local-admin-token
# Required even when SELLER_BRIDGE_ENABLED=false; use a distinct random value.
BAP_SELLER_BRIDGE_TOKEN=replace-with-random-local-seller-bridge-token
BAP_SUBSCRIBER_URL=http://bap:8003/api/v1/beckn
# Seller BPP is external to this repo; unreachable placeholder disables its proxy.
BPP_URL=http://external-bpp.invalid:8001
# Public Firebase client configuration, embedded at BUILD time. Blank disables login.
# Never use Firebase Admin/service-account/private keys as build arguments.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
